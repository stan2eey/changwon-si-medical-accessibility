---
import Layout from '../layouts/Layout.astro';
import '../styles/report.css';
const base=import.meta.env.BASE_URL;
---
<Layout title="보고서 보기"><main id="main" class="report-page">
 <div class="report-heading"><h1>보고서 보기</h1><a href={base+'reports/changwon-medical-report.pdf'} download>PDF 내려받기 ↓</a></div>
 <section class="pdf-reader" id="pdf-reader" aria-label="보고서 PDF 뷰어" data-pdf={base+'reports/changwon-medical-report.pdf'} tabindex="0">
  <div class="reader-toolbar">
   <div class="view-controls"><label for="pdf-zoom" class="sr-only">확대 비율</label><select id="pdf-zoom" aria-label="확대 비율"><option value="fit">두 페이지</option><option value="width">너비 맞춤</option><option value="1.5">150%</option><option value="2">200%</option></select><button id="pdf-fullscreen" type="button" aria-pressed="false">전체화면</button></div>
  </div>
  <div id="pdf-viewport" class="pdf-viewport" aria-busy="true"><div id="pdf-sheet" class="pdf-sheet"></div></div>
  <button id="book-prev" class="book-arrow book-arrow-prev" type="button" aria-label="이전 두 페이지" disabled>‹</button>
  <button id="book-next" class="book-arrow book-arrow-next" type="button" aria-label="다음 두 페이지" disabled>›</button>
  <span id="pdf-status" class="sr-only" role="status" aria-live="polite">보고서를 불러오고 있습니다.</span>
  <p id="pdf-error" hidden>보고서를 표시하지 못했습니다. <a href={base+'reports/changwon-medical-report.pdf'} target="_blank" rel="noopener">PDF 원본 열기</a>로 확인할 수 있습니다.</p>
 </section>
</main><script>import '../scripts/report.js';</script></Layout>
