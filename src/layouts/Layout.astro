---
import '../styles/global.css';
const {story=false,title='창원 의료접근성 지도',description='우리 동네에서 병원까지'}=Astro.props;
const base=import.meta.env.BASE_URL;
const links=[['','기사 읽기'],['report/','보고서 보기'],['cities/','도시별 비교'],['explore/','100m 의료지도'],['methods/','분석방법'],['data/','자료']];
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f6f5f0"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><title>{story ? title : `${title}, 창원 의료접근성`}</title><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/></head><body class={story ? "story-site" : undefined}><a class="skip" href="#main">본문 바로가기</a><header class="site-header"><a class="brand" href={base}><span class="brand-report"><span class="brand-title">창원시 읍, 면, 동별 의료자원의 공간적 분석 및 시사점</span></span></a><nav aria-label="주 메뉴">{links.map(([path,label])=><a href={`${base}${path}`} aria-current={Astro.url.pathname===`${base}${path}`?'page':undefined}>{label}</a>)}</nav></header><slot/><footer><span>작성일시 2026.10.30, <a href={`${base}data/#versions`}>자료 기준일</a></span></footer></body></html>
