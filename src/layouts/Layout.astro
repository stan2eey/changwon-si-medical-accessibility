---
import '../styles/global.css';
const {story=false,title='창원 의료접근성 지도',description='우리 동네에서 병원까지'}=Astro.props;
const base=import.meta.env.BASE_URL;
const links=[['','기사 읽기'],['report/','보고서 보기'],['cities/','도시별 비교'],['explore/','100m 의료지도'],['methods/','분석방법'],['data/','자료']];
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#f6f5f0"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><title>{story ? title : `${title}, 창원 의료접근성`}</title><link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`}/><script is:inline>if(new URLSearchParams(location.search).get('embed')==='1')document.documentElement.classList.add('embed-mode')</script></head><body class={story ? "story-site" : undefined}><a class="skip" href="#main">본문 바로가기</a><header class="site-header"><a class="brand" href={base}><span class="brand-report"><span class="brand-title">창원시 읍, 면, 동별 의료자원의 공간적 분석 및 시사점</span></span></a><nav aria-label="주 메뉴">{links.map(([path,label])=><a href={`${base}${path}`} aria-current={Astro.url.pathname===`${base}${path}`?'page':undefined}>{label}</a>)}</nav></header><p class="pc-notice">모바일 접속자의 경우, 이 사이트는 PC에서 최적화되어 있습니다.</p><slot/><footer><span>작성일시 2026.10.30, <a href={`${base}data/#versions`}>자료 기준일</a></span><span class="visit-count" hidden><a id="visit-link" href="https://countapi.mileshilliard.com/api/v1/get/stan2eey-changwon-site/shield?label=%EC%A1%B0%ED%9A%8C">조회 <span id="visit-number"></span></a></span></footer><script is:inline>if(!document.documentElement.classList.contains('embed-mode')&&location.hostname==='stan2eey.github.io'){fetch('https://countapi.mileshilliard.com/api/v1/hit/stan2eey-changwon-site').then(function(r){return r.json()}).then(function(d){if(d&&d.value!=null){document.getElementById('visit-number').textContent=Number(d.value).toLocaleString('ko-KR');document.querySelector('.visit-count').hidden=false}}).catch(function(){})}</script></body></html>
