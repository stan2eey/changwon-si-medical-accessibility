---
const policies = [
 {
  "id": "birth",
  "phase": "단기",
  "title": "분만기관의 전문의 인건비와 당직 유지비 지원",
  "description": "산부인과 전문의와 간호인력의 인건비, 야간과 휴일의 당직 유지비를 지원하는 방안입니다. 지원기관이 제공할 진료시간과 인력 배치를 정하고, 다른 병원으로 옮겨야 할 때의 연락과 수용 확인 절차를 협약에 담습니다.",
  "summary": "당직, 운영비 지원과 전원 협약",
  "caseTitle": "경주시, 2024년 협약 사례",
  "caseText": "산부인과 전문의 1명 인건비로 월 1,250만 원을 지원하고, 맘존여성병원이 24시간 분만의료 서비스를 제공하도록 협약했습니다.",
  "sources": [
   [
    "경주시 지원협약",
    "https://www.gyeongju.go.kr/news/page.do?mnu_uid=1336&parm_bod_uid=283000&step=258"
   ]
  ],
  "steps": [
   [
    "왜 운영을 지원하나요?",
    "분만 건수가 줄어도 출산에 대응할 인력과 시설의 유지비는 발생합니다. 출혈 등 합병증에는 신속한 처치가 필요하므로, 분만실적과 함께 당직 유지 능력과 대체기관까지의 거리를 고려합니다."
   ],
   [
    "어떤 비용을 지원하나요?",
    "진동면처럼 가까운 분만 대체기관이 제한된 지역을 담당하는 기관부터 인력과 운영비를 확인합니다. 전문의 추가 채용비, 간호인력 인건비, 당직수당을 구분하고 기존 지원과 중복되는 비용을 조정합니다."
   ],
   [
    "어떤 조건을 약속하나요?",
    "채용 지원과 당직 유지 지원을 구분해 근무기간, 운영시간, 대체인력 확보방식을 정합니다. 마취, 수술, 신생아 진료의 대응 범위와 전원 연락창구를 협약에 담고, 수용 확인과 이송 절차를 점검합니다."
   ]
  ]
 },
 {
  "id": "stay",
  "phase": "단기",
  "title": "병원에서 먼 임신부에게 출산 전 숙소와 이동비 지원",
  "description": "분만기관까지 멀거나 야간 교통편이 부족한 임신부에게 병원 인근 기존 주택이나 숙소를 지원하는 방안입니다. 임신부와 의료진이 체류 시기를 정하고, 보호자 동반과 외래진료 이동, 응급 이송을 함께 준비합니다.",
  "summary": "이용대상과 숙소 운영방식",
  "caseTitle": "춘천, 응급산모 안심스테이 품안애",
  "caseText": "LH, 강원도, 강원대병원이 협력한 병원 인근 거주시설입니다. 사업단 안내의 지원기간은 출산 6주 전부터 출산 후 3일까지입니다.",
  "sources": [
   [
    "품안애 사업단 안내",
    "https://www.hwangs.kr/bbs/board.php?bo_table=s4_1&wr_id=2"
   ],
   [
    "LH, 춘천 주거 지원 사례",
    "https://www.myhome.go.kr/hws/portal/bbs/selectBoardHappyNewsDetailView.do?bbsId=BBST06&nttId=591"
   ]
  ],
  "steps": [
   [
    "기존 숙소부터 확보",
    "북면, 진전면, 진동면 등에서 이용 의향을 조사한 뒤 병원 인근 숙소를 소규모로 확보합니다. 국제적으로는 이러한 병원 인근 체류시설을 분만 대기시설, Maternity Waiting Homes(MWHs)라고 부릅니다."
   ],
   [
    "신청부터 병원 이동까지",
    "보건소가 신청을 받고 의료진과 체류 시기를 협의합니다. 보호자 동반 객실, 외래진료 교통비, 숙소 관리비를 함께 검토하고 병원 연락과 응급 이송방법을 안내합니다. 출산 일정 변경에 따른 연장과 취소 기준도 정합니다."
   ],
   [
    "숙박비 산정 예시",
    "임신부 20명에게 1박 최대 7만 원, 최대 14박을 지원하면 숙박비 한도는 1,960만 원입니다. 교통비와 숙소 관리비는 별도이며, 실제 대상인원과 기간은 수요조사 후 정합니다."
   ]
  ]
 },
 {
  "id": "pediatric",
  "phase": "단기",
  "title": "도심과 도농지역을 함께 담당하는 연합형 소아 진료",
  "description": "의창구 도심의 A의원은 월, 수, 금에, 도농지역의 B의원은 화, 목, 토에 진료하는 연합형 운영을 제안합니다. 진료 장소를 두 생활권에 나눠 두면 도농지역 주민도 해당 요일에는 가까운 기관에서 진료받을 수 있습니다. 창원시는 추가 진료비용을 지원하고 요일별 병원과 약국 정보를 함께 안내합니다.",
  "summary": "지역별 참여기관 선정과 운영비 지원",
  "caseTitle": "양주시와 도봉구, 2026년 지원 사례",
  "caseText": "양주시는 의료취약지역 야간진료에 시간당 20만 원, 하루 최대 2.5시간과 50만 원을 지원조건으로 제시합니다. 도봉구는 인접한 2개 이상 기관이 요일을 나눠 주 7일 진료하는 연합 운영을 안내합니다.",
  "sources": [
   [
    "양주시 시간당 운영비 지원",
    "https://www.yangju.go.kr/www/selectBudgetBizDetail.do?dbizCd=5590000202630063&fisYear=2026&key=2707"
   ],
   [
    "도봉구 연합 운영과 지원조건",
    "https://health.dobong.go.kr/bbs.asp?bmode=D&code=10005006&intPage=2&pcode=12741389&strSearchType=1"
   ]
  ],
  "steps": [
   [
    "두 생활권을 함께 담당할 기관 선정",
    "도심 한 곳에서 운영하는 경우와 도심, 도농지역의 기관이 연합하는 경우를 비교합니다. 의창구 내 참여기관의 위치, 소아 인구, 요일별 이동시간을 확인해 가까운 진료기관을 이용할 수 있는 지역을 넓히는 조합을 선정합니다. 기관 간 거리와 공동 운영 가능성은 연합형 지정 기준에 맞춰 협의합니다."
   ],
   [
    "요일과 지역을 함께 정하기",
    "도심 A의원은 월, 수, 금, 도농지역 B의원은 화, 목, 토에 맡고 일요일과 공휴일은 교대로 운영하는 예시입니다. 두 지역에서 매일 동시에 진료하는 방식은 아니므로, 요일별로 남는 진료 공백과 이동 부담을 확인해 운영일을 조정합니다. 대상 연령, 접수 마감시간, 대체기관과 협력약국도 함께 정합니다."
   ],
   [
    "지원방식 구분",
    "실제 추가 진료시간에 따라 운영비를 지급하거나, 정해진 진료시간을 유지하는 기관에 연간 운영비를 지원할 수 있습니다. 도봉구의 2026년 안내는 주당 운영시간에 따른 연간 운영비 1억 6,000만~3억 6,000만 원과 환자당 야간진료관리료 1만 3,890~2만 3,450원을 구분합니다. 운영비 지원과 건강보험 수가를 함께 확인해 시가 추가 부담할 비용을 정합니다."
   ],
   [
    "단시간 시범사업 예산",
    "달빛어린이병원 운영시간을 충족하기 어려운 기관에는 별도 시범사업을 검토합니다. 두 기관이 각각 오후 6~8시, 주 3일씩 26주 진료하고 시간당 20만 원을 지원하면 운영비는 6,240만 원입니다. 이 계산에는 일요일과 공휴일의 추가 운영비가 포함되지 않습니다. 실제 개원일, 이용자 수, 휴진 사유를 확인해 운영안을 조정합니다."
   ]
  ]
 },
 {
  "id": "workforce",
  "phase": "장기",
  "title": "의대 유치와 지역 의료인력의 장기근무 지원",
  "description": "의대 유치의 타당성 검토와 기존 의료인력의 근무 지원을 병행합니다. 교육과 수련 여건을 살피는 한편, 현재 인력이 겪는 당직 부담과 주거, 가족 정착의 어려움을 확인해 지원 항목을 정합니다.",
  "summary": "교육, 수련 및 근무 지원",
  "caseTitle": "계약형 지역필수의사제, 2026년 추가 공모",
  "caseText": "전문의 경력 5년 이하 의사가 종합병원 이상 지역의료기관에서 필수과목을 장기간 맡도록 월 400만 원의 지역근무수당과 정주 혜택을 지원하는 국가사업입니다.",
  "sources": [
   [
    "보건복지부 공모자료, KDI 수록",
    "https://epts.kdi.re.kr/archive/frwdHist/view2?EPIC_NUM=281497"
   ]
  ],
  "steps": [
   [
    "교육과 수련 여건",
    "지역 의료 수요, 교육시설과 임상실습 수용 능력을 바탕으로 의대 유치의 타당성을 검토합니다. 창원경상국립대학교병원, 삼성창원병원 등과 지도전문의, 수련환경, 공동교육의 협력 가능성을 살펴봅니다."
   ],
   [
    "현재 인력의 근무 지원",
    "경상남도와 국가사업의 참여기관과 과목을 협의하고, 기존 지원에 주거와 통근, 연수 지원을 보완합니다. 미충원 기간과 퇴직 사유를 조사해 임차료, 병원 숙소, 추가 당직인력, 교육기간 대체인력 등 필요한 항목을 정합니다."
   ],
   [
    "장기근무 확인",
    "근무기간과 담당 진료과를 계약에 명시합니다. 신규 채용인원뿐 아니라 1년, 3년 근속인원과 해당 과목의 진료 유지 여부를 함께 확인합니다."
   ]
  ]
 },
 {
  "id": "agreement",
  "phase": "장기",
  "title": "지원할 비용은 조례에, 제공할 진료는 협약에 명시",
  "description": "추가 진료 인건비, 분만 당직비, 진료협력 인력, 임신부 숙박비와 교통비의 지원 근거를 정비합니다. 지원기관이 맡을 진료일과 시간을 협약에 적고, 약속한 진료가 실제 제공됐는지 확인합니다.",
  "summary": "지원조건과 평가항목",
  "caseTitle": "경주시, 지원 근거부터 협약까지",
  "caseText": "2024년 7월 공공보건의료 조례 제정, 8~9월 사업자 공모와 간담회를 거쳐 10월 분만기관 인건비 지원협약을 체결했습니다.",
  "sources": [
   [
    "경주시 사업 추진 사례",
    "https://www.gyeongju.go.kr/news/page.do?mnu_uid=1336&parm_bod_uid=283000&step=258"
   ]
  ],
  "steps": [
   [
    "조례와 공모 기준",
    "현행 조례의 지원 범위를 확인하고 부족한 근거를 보완합니다. 지원 항목, 대상기관 선정, 지원한도, 국비와 도비 사업의 중복 조정, 정산과 환수 기준을 구체화합니다."
   ],
   [
    "주민에게 제공할 서비스 명시",
    "야간진료는 담당 요일, 접수시간, 투입인력과 협력약국을 정합니다. 분만 지원은 당직 편성, 진료 중단 시 통보, 대체기관 연락 절차를 협약에 담습니다."
   ],
   [
    "지출과 진료 실적 함께 확인",
    "월별 운영실적을 받고 분기별로 진료일과 시간의 이행 여부, 예산 집행을 확인합니다. 진료 유지 실적과 생활권별 접근성 변화를 바탕으로 다음 연도의 지원조건을 조정합니다."
   ]
  ]
 }
];
const phases = [{name:'단기',tone:'short'},{name:'장기',tone:'long'}];
---
<section class="policy-options" id="policy-options" aria-labelledby="policy-options-title">
 <h2 id="policy-options-title">의료접근성을 높이기 위한 <span class="keep-phrase">정책제안</span></h2>
 {phases.map(phase=><div class:list={['policy-phase',phase.tone]}>
  <h3 class="phase-title">{phase.name}</h3>
  <div class="policy-grid">
   {policies.filter(p=>p.phase===phase.name).map(policy=><article class:list={['policy-card',policy.id]}>
    <h4>{policy.title}</h4>
    <p class="proposal">{policy.description}</p>
    <div class="policy-visual">
    {policy.id==='birth'&&<div class="support-diagram" aria-label="분만기관 지원과 기관의 역할">
     <div><strong>지자체가 지원할 비용</strong><p>전문의와 간호인력 인건비<br/>야간, 휴일 당직 유지비</p></div>
     <div><strong>기관이 제공할 진료</strong><p>협약한 시간의 분만 진료<br/>당직 배치와 전원 연락</p></div>
    </div>}
    {policy.id==='stay'&&<figure class="stay-diagram">
     <div class="stay-route"><div><strong>병원 인근 숙소</strong><span>보호자 동반, 출산 전 체류</span></div><span aria-hidden="true">↔</span><div><strong>분만기관</strong><span>외래진료, 출산과 응급대응</span></div></div>
     <figcaption>숙소와 병원 사이의 이동 지원, 연락과 이송 절차를 함께 마련</figcaption>
    </figure>}
    {policy.id==='pediatric'&&<div class="schedule" data-policy-schedule data-shared-mode="true">
     <h5>의창구의 두 생활권을 나눠 맡는 운영 예시</h5>
     <div class="coverage-diagram">
      <div class="coverage-area urban"><span>의창구 도심</span><strong>A의원</strong><p data-urban-days>월, 수, 금</p><small>도심 주민의 가까운 진료기관</small></div>
      <div class="coverage-area rural"><span>의창구 도농지역</span><strong>B의원</strong><p data-rural-days>화, 목, 토</p><small data-rural-note>도농지역에도 가까운 진료기관 확보</small></div>
     </div>
     <div class="schedule-controls" aria-label="진료일 운영 예시 선택">
      <button type="button" data-mode="solo" aria-pressed="false">도심 단독 운영 예시</button>
      <button type="button" data-mode="shared" aria-pressed="true">도심, 도농 연합 운영 예시</button>
     </div>
     <div class="table-scroll"><table><caption class="sr-only">야간, 휴일 진료 담당기관 예시</caption><thead><tr>{['월','화','수','목','금','토','일, 공휴일'].map(day=><th scope="col">{day}</th>)}</tr></thead>
      <tbody><tr>{['도심 A','도농 B','도심 A','도농 B','도심 A','도농 B','교대'].map((name,i)=><td data-shared={name} data-institution={i%2===0?'a':'b'}>{name}</td>)}</tr></tbody></table></div>
     <p class="schedule-note" aria-live="polite">진료 장소를 도심과 도농지역으로 분산해, 한 주 동안 가까운 진료기관을 이용할 수 있는 지역을 넓히는 방식입니다.</p>
    </div>}
    {policy.id==='workforce'&&<div class="support-diagram"><div><strong>의대 유치</strong><p>교육시설과 임상실습<br/>지도인력과 수련 여건</p></div><div><strong>현재 인력의 장기근무</strong><p>당직 분담과 대체인력<br/>주거, 통근, 연수 지원</p></div></div>}
    {policy.id==='agreement'&&<div class="table-scroll agreement-table"><table><caption>지원조건 예시</caption><thead><tr><th scope="col">지원할 비용</th><th scope="col">기관의 약속</th><th scope="col">확인할 실적</th></tr></thead><tbody>
     <tr><th scope="row">추가 진료 운영비</th><td>진료일과 접수시간</td><td>실제 개원일과 진료시간</td></tr>
     <tr><th scope="row">분만 당직비</th><td>당직 인력과 대체인력</td><td>당직 편성과 진료 유지</td></tr>
    </tbody></table></div>}
    {policy.id==='pediatric'&&<aside class="budget"><span>창원 적용 예시, 단시간 야간진료 운영비</span><strong>6,240만 원</strong><p>2개 기관 × 하루 2시간 × 주 3일 × 26주 × 시간당 20만 원<br/>일요일과 공휴일 추가 운영비는 별도</p></aside>}
    </div>
    {policy.caseTitle&&<div class="case"><h5>{policy.caseTitle}</h5><p>{policy.caseText}</p>
     <div class="policy-links">{policy.sources.map(([label,url])=><a href={url} target="_blank" rel="noopener noreferrer">{label}<span class="sr-only"> (새 창)</span></a>)}</div>
    </div>}
    <details><summary>{policy.summary}</summary>
    {policy.id==='stay'&&<aside class="budget"><span>창원 적용 예시, 숙박비 한도</span><strong>최대 1,960만 원</strong><p>20명 × 14박 × 1박 7만 원<br/>교통비와 숙소 관리비는 별도</p></aside>}

     <div class="detail-content">{policy.steps.map(([title,body])=><section><h5>{title}</h5><p>{body}</p></section>)}</div>
     {policy.id==='birth'&&<div class="policy-links"><a href="https://www.who.int/news-room/fact-sheets/detail/maternal-mortality">WHO, 출산 합병증과 신속한 치료</a><a href="https://repository.hira.or.kr/bitstream/2019.oak/1045/1/미국 농촌지역에서의 병원서비스 접근성 확보를 위한 진료비용 지원.pdf">심평원, 분만서비스의 고정비용</a></div>}
     {policy.id==='stay'&&<div class="policy-links"><a href="https://www.ncbi.nlm.nih.gov/books/NBK304991/">WHO, 분만 대기시설</a></div>}
    </details>
   </article>)}
  </div>
 </div>)}
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-policy-schedule]').forEach(schedule=>{
  schedule.querySelectorAll<HTMLButtonElement>('button[data-mode]').forEach(button=>{
   button.addEventListener('click',()=>{
    const shared=button.dataset.mode==='shared';
    schedule.querySelectorAll<HTMLButtonElement>('button[data-mode]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
    schedule.querySelectorAll<HTMLElement>('td[data-shared]').forEach(cell=>{
     cell.textContent=shared?cell.dataset.shared??'':'도심 A';
     cell.dataset.solo=String(!shared);
    });
    schedule.dataset.sharedMode=String(shared);
    const urban=schedule.querySelector('[data-urban-days]');
    const rural=schedule.querySelector('[data-rural-days]');
    const ruralNote=schedule.querySelector('[data-rural-note]');
    if(urban)urban.textContent=shared?'월, 수, 금':'월요일부터 일요일까지';
    if(rural)rural.textContent=shared?'화, 목, 토':'참여기관 없음';
    if(ruralNote)ruralNote.textContent=shared?'도농지역에도 가까운 진료기관 확보':'도심 기관까지 이동';
    const note=schedule.querySelector('.schedule-note');
    if(note)note.textContent=shared?'진료 장소를 도심과 도농지역으로 분산해, 한 주 동안 가까운 진료기관을 이용할 수 있는 지역을 넓히는 방식입니다.':'도심 한 곳에서 모든 요일을 맡으면, 도농지역 주민도 도심 기관까지 이동해야 합니다.';
   });
  });
 });
</script>
<style>
