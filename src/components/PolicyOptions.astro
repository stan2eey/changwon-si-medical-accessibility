 .stay-route strong{font-size:16px}.stay-route span{display:block;font-size:13px;line-height:1.7;margin-top:7px;word-break:keep-all}
 figcaption{font-size:13px;line-height:1.7;word-break:keep-all;margin-top:18px;text-align:center}
 .schedule{margin:24px 0}.schedule-controls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
 .policy-options button{border:1px solid #82968b;background:#fffdf8;color:#24483d;padding:12px 16px;font:inherit;font-size:14px;cursor:pointer}
 .policy-options button[aria-pressed=true]{background:var(--phase);color:white;border-color:var(--phase)}
 .policy-options button:focus-visible,.policy-options summary:focus-visible,.policy-links a:focus-visible{outline:3px solid #216eaa;outline-offset:3px}
 .table-scroll{overflow-x:auto}
