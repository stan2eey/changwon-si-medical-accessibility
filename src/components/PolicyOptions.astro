<section class="policy-options" id="policy-options" aria-labelledby="policy-options-title">
 <h2 id="policy-options-title">의료접근성을 높이기 위한 <span class="keep-phrase">정책제안</span></h2>
 {phases.map(phase=><div class:list={['policy-phase',phase.tone]}>
  <h3 class="phase-title">{phase.name}</h3>
  <div class="policy-grid">
   {policies.filter(p=>p.phase===phase.name).map(policy=><article class:list={['policy-card',policy.id]}>
    <h4>{policy.title}</h4>
    <p class="proposal">{policy.description}</p>
    {policy.id==='birth'&&<div class="support-diagram" aria-label="분만기관 지원과 기관의 역할">
     <div><strong>지자체가 지원할 비용</strong><p>전문의와 간호인력 인건비<br/>야간, 휴일 당직 유지비</p></div>
     <div><strong>기관이 제공할 진료</strong><p>협약한 시간의 분만 진료<br/>당직 배치와 전원 연락</p></div>
    </div>}
    {policy.id==='stay'&&<figure class="stay-diagram">
     <div class="stay-route"><div><strong>병원 인근 숙소</strong><span>보호자 동반, 출산 전 체류</span></div><span aria-hidden="true">↔</span><div><strong>분만기관</strong><span>외래진료, 출산과 응급대응</span></div></div>
     <figcaption>숙소와 병원 사이의 이동 지원, 연락과 이송 절차를 함께 마련</figcaption>
    </figure>}
    {policy.id==='pediatric'&&<div class="schedule" data-policy-schedule>
     <div class="schedule-controls" aria-label="진료일 운영 예시 선택">
      <button type="button" data-mode="solo" aria-pressed="false">단독 운영 예시</button>
      <button type="button" data-mode="shared" aria-pressed="true">분담 운영 예시</button>
     </div>
     <div class="table-scroll"><table><caption class="sr-only">야간, 휴일 진료 담당기관 예시</caption><thead><tr>{['월','화','수','목','금','토','일, 공휴일'].map(day=><th scope="col">{day}</th>)}</tr></thead>
      <tbody><tr>{['A의원','B의원','A의원','B의원','A의원','B의원','교대'].map((name,i)=><td data-shared={name} data-institution={i%2===0?'a':'b'}>{name}</td>)}</tr></tbody></table></div>
     <p class="schedule-note" aria-live="polite">두 기관이 진료일을 나누고, 일요일과 공휴일은 교대로 맡는 예시입니다.</p>
    </div>}
    {policy.id==='referral'&&<div class="referral-flow">
     <div class="flow-buttons" aria-label="진료 연계 절차">{referralSteps.map(([title,body],i)=><button type="button" data-flow-description={body} aria-pressed={i===0?'true':'false'} aria-controls="policy-flow-description"><span>{i+1}</span>{title}</button>)}</div>
     <p id="policy-flow-description" aria-live="polite">{referralSteps[0][1]}</p>
    </div>}
    {policy.id==='workforce'&&<div class="support-diagram"><div><strong>의대 유치</strong><p>교육시설과 임상실습<br/>지도인력과 수련 여건</p></div><div><strong>현재 인력의 장기근무</strong><p>당직 분담과 대체인력<br/>주거, 통근, 연수 지원</p></div></div>}
    {policy.id==='agreement'&&<div class="table-scroll agreement-table"><table><caption>지원조건 예시</caption><thead><tr><th scope="col">지원할 비용</th><th scope="col">기관의 약속</th><th scope="col">확인할 실적</th></tr></thead><tbody>
     <tr><th scope="row">추가 진료 운영비</th><td>진료일과 접수시간</td><td>실제 개원일과 진료시간</td></tr>
     <tr><th scope="row">분만 당직비</th><td>당직 인력과 대체인력</td><td>당직 편성과 진료 유지</td></tr>
    </tbody></table></div>}
    {policy.id==='stay'&&<aside class="budget"><span>창원 적용 예시, 숙박비 한도</span><strong>최대 1,960만 원</strong><p>20명 × 14박 × 1박 7만 원<br/>교통비와 숙소 관리비는 별도</p></aside>}
    {policy.id==='pediatric'&&<aside class="budget"><span>창원 적용 예시, 단시간 야간진료 운영비</span><strong>6,240만 원</strong><p>2개 기관 × 하루 2시간 × 주 3일 × 26주 × 시간당 20만 원<br/>일요일과 공휴일 추가 운영비는 별도</p></aside>}
    {policy.caseTitle&&<div class="case"><h5>{policy.caseTitle}</h5><p>{policy.caseText}</p>
     <div class="policy-links">{policy.sources.map(([label,url])=><a href={url} target="_blank" rel="noopener noreferrer">{label}<span class="sr-only"> (새 창)</span></a>)}</div>
    </div>}
    <details><summary>{policy.summary}</summary>
     <div class="detail-content">{policy.steps.map(([title,body])=><section><h5>{title}</h5><p>{body}</p></section>)}</div>
     {policy.id==='birth'&&<div class="policy-links"><a href="https://www.who.int/news-room/fact-sheets/detail/maternal-mortality">WHO, 출산 합병증과 신속한 치료</a><a href="https://repository.hira.or.kr/bitstream/2019.oak/1045/1/미국 농촌지역에서의 병원서비스 접근성 확보를 위한 진료비용 지원.pdf">심평원, 분만서비스의 고정비용</a></div>}
     {policy.id==='stay'&&<div class="policy-links"><a href="https://www.ncbi.nlm.nih.gov/books/NBK304991/">WHO, 분만 대기시설</a></div>}
    </details>
   </article>)}
  </div>
 </div>)}
</section>
<script>
 document.querySelectorAll<HTMLElement>('[data-policy-schedule]').forEach(schedule=>{
  schedule.querySelectorAll<HTMLButtonElement>('button[data-mode]').forEach(button=>{
   button.addEventListener('click',()=>{
    const shared=button.dataset.mode==='shared';
    schedule.querySelectorAll<HTMLButtonElement>('button[data-mode]').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
    schedule.querySelectorAll<HTMLElement>('td[data-shared]').forEach(cell=>{
     cell.textContent=shared?cell.dataset.shared??'':'A의원';
     cell.dataset.solo=String(!shared);
    });
    const note=schedule.querySelector('.schedule-note');
    if(note)note.textContent=shared?'두 기관이 진료일을 나누고, 일요일과 공휴일은 교대로 맡는 예시입니다.':'한 기관이 모든 요일의 진료를 맡는 예시입니다.';
   });
  });
 });
 document.querySelectorAll<HTMLElement>('.referral-flow').forEach(flow=>{
  flow.querySelectorAll<HTMLButtonElement>('button[data-flow-description]').forEach(button=>{
   button.addEventListener('click',()=>{
    flow.querySelectorAll('button').forEach(item=>item.setAttribute('aria-pressed',String(item===button)));
    const description=flow.querySelector('#policy-flow-description');
    if(description)description.textContent=button.dataset.flowDescription??'';
   });
  });
 });
</script>
<style>
 .policy-options{position:relative;z-index:8;padding:76px 6vw;background:#fffdf8;color:#24483d;border-top:1px solid #b7c2b7}
 .policy-options h2{max-width:950px;font-size:clamp(27px,3.1vw,42px);line-height:1.4;letter-spacing:-.045em;word-break:keep-all;margin:0 0 36px}
 .policy-phase{--phase:#3f6754;--surface:#f3f6ef;margin-top:36px}
 .policy-phase.medium{--phase:#365f78;--surface:#f0f5f8}.policy-phase.long{--phase:#796043;--surface:#f7f3eb}
 .phase-title{color:var(--phase);font-size:20px;margin:0 0 12px}
 .policy-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px;align-items:start}
 .pediatric,.referral{grid-column:1/-1}
 .policy-card{min-width:0;border:1px solid #b9c2ba;border-top:4px solid var(--phase);padding:28px;background:var(--surface)}
 .policy-card h4{font-size:clamp(22px,2vw,28px);line-height:1.5;letter-spacing:-.035em;word-break:keep-all;margin:0 0 18px;max-width:850px}
 .policy-card p{font-size:16px;line-height:1.85;word-break:keep-all;overflow-wrap:break-word;margin:0}
 .proposal{max-width:900px}.policy-card h5{font-size:16px;line-height:1.6;margin:0 0 8px}
 .support-diagram{display:grid;grid-template-columns:1fr 1fr;border:1px solid #b9c2ba;margin:24px 0;background:#fffdf8}
 .support-diagram>div{padding:16px}.support-diagram>div+div{border-left:1px solid #b9c2ba}
 .support-diagram strong{font-size:15px;display:block;margin-bottom:9px;word-break:keep-all}.support-diagram p{font-size:14px}
 .stay-diagram{margin:24px 0;padding:18px 14px;border:1px solid #b9c2ba;background:#fffdf8}
 .stay-route{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:12px;text-align:center}
 .stay-route strong{font-size:16px}.stay-route span{display:block;font-size:13px;line-height:1.7;margin-top:7px;word-break:keep-all}
 figcaption{font-size:13px;line-height:1.7;word-break:keep-all;margin-top:18px;text-align:center}
 .schedule{margin:24px 0}.schedule-controls{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px}
 .policy-options button{border:1px solid #82968b;background:#fffdf8;color:#24483d;padding:12px 16px;font:inherit;font-size:14px;cursor:pointer}
 .policy-options button[aria-pressed=true]{background:var(--phase);color:white;border-color:var(--phase)}
 .policy-options button:focus-visible,.policy-options summary:focus-visible,.policy-links a:focus-visible{outline:3px solid #216eaa;outline-offset:3px}
 .table-scroll{overflow-x:auto}
 .policy-options table{border-collapse:collapse;width:100%;font-size:14px;background:#fffdf8}
 .policy-options th,.policy-options td{border:1px solid #b9c2ba;padding:12px 9px;text-align:left;line-height:1.6}
 .schedule table{min-width:480px;table-layout:fixed}.schedule th,.schedule td{text-align:center}
 .schedule td[data-institution=b]:not([data-solo=true]){background:#e1ebf4;color:#204b68}
 .schedule td[data-institution=a],.schedule td[data-solo=true]{background:#e7eee0}
 .policy-card .schedule-note{font-size:14px;margin-top:10px}
 .agreement-table{margin:24px 0}.agreement-table table{min-width:340px}
 caption{text-align:left;font-weight:700;padding-bottom:10px}
 .budget{padding:18px 20px;border-left:3px solid var(--phase);background:#fffdf8;margin:24px 0}
 .budget>span{font-size:13px;line-height:1.6;display:block}.budget>strong{display:block;font-size:27px;margin:8px 0}.budget p{font-size:14px}
 .case{border-top:1px solid #c4ccc4;padding-top:20px;margin-top:24px}.case p{font-size:15px}
 .policy-links{display:flex;flex-wrap:wrap;gap:10px 18px;margin-top:12px}
 .policy-links a{font-size:13px;line-height:1.6;text-decoration:underline;text-underline-offset:3px;color:#345f69;overflow-wrap:anywhere}
 details{border-top:1px solid #c4ccc4;padding-top:10px;margin-top:24px}
 summary{cursor:pointer;font-size:15px;font-weight:700;padding:12px 0;line-height:1.6}
 .detail-content section{margin:20px 0}.detail-content p{font-size:15px}
 .referral-flow{margin:24px 0}.flow-buttons{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
 .flow-buttons button{text-align:left;line-height:1.7}.flow-buttons span{display:block;font-size:12px;margin-bottom:5px}
 #policy-flow-description{padding:18px;background:#fffdf8;border:1px solid #b9c2ba;margin-top:12px;min-height:68px}
 .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
 @media(min-width:1051px){.pediatric .detail-content,.referral .detail-content{display:grid;grid-template-columns:repeat(3,1fr);gap:28px}}
 @media(max-width:900px){.policy-grid{grid-template-columns:minmax(0,1fr)}}
 @media(max-width:600px){.policy-options{padding:48px 6vw}.policy-card{padding:20px}.policy-options h2{margin-bottom:26px}.support-diagram{grid-template-columns:1fr}.support-diagram>div+div{border-left:0;border-top:1px solid #b9c2ba}.flow-buttons{grid-template-columns:1fr 1fr}.stay-route{gap:7px}.stay-route strong{font-size:14px}}
 @media(max-width:600px){.schedule table{min-width:0;font-size:12px}.schedule th,.schedule td{padding:12px 2px}.schedule th:last-child{width:64px}.agreement-table table{min-width:0;font-size:13px}.agreement-table th,.agreement-table td{padding:10px 6px}}
 @media print{.policy-options{padding:24px 0}.policy-card{break-inside:avoid}.policy-grid{gap:12px}}
</style>
