 .coverage-area>span,.coverage-area>strong,.coverage-area>small{display:block}
 .coverage-area>span{font-size:14px}.coverage-area>strong{font-size:24px;margin:8px 0}
 .coverage-area>small{font-size:14px;line-height:1.7;margin-top:10px;word-break:keep-all}
 [data-shared-mode=false] .coverage-area.rural{background:#efefeb;border-style:dashed;color:#59615b}
 @media(max-width:600px){.coverage-diagram{gap:10px}.coverage-area{padding:14px}.coverage-area>small{font-size:12px}.coverage-area>strong{font-size:21px}}
 @media print{.policy-options{padding:24px 0}.policy-card{break-inside:avoid}.policy-grid{gap:12px}}
</style>
